# Not part of the site (PRO-150).
#
# assets.directory is "." — the whole website/ folder — and the deploy runs
# `npx wrangler` with website/ as its working directory, so wrangler installs
# itself into website/node_modules right before reading the assets. That put a
# 146 MiB workerd binary in the upload set and failed the deploy on Workers'
# 25 MiB per-asset limit.
node_modules

# Deploy configuration, not content.
wrangler.jsonc
